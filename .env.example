# KEVIDENCE Environment Configuration
# Copy to .env and fill in your values

# ── LLM Provider ─────────────────────────────────────────────
# Options: gemini, openai, anthropic, mock
# Mock requires no API key. Choose a hosted provider and add its key to regenerate with an LLM.
LLM_PROVIDER=mock

# Gemini (default, free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── NVD API ──────────────────────────────────────────────────
# Optional: speeds up NVD fetching (50 req/30s vs 5 req/30s)
NVD_API_KEY=

# ── Database ─────────────────────────────────────────────────
PHANTOMPATCH_DB=phantompatch.db

# ── Scoring ──────────────────────────────────────────────────
CVSS_WEIGHT=0.3
EPSS_WEIGHT=0.3
KEV_WEIGHT=0.4
THRESHOLD_CRITICAL=0.75
THRESHOLD_HIGH=0.50
THRESHOLD_MEDIUM=0.25

# ── Verifier ─────────────────────────────────────────────────
SIMILARITY_THRESHOLD=0.60
RETRY_BELOW=0.95
MAX_RETRIES=2
CONFIDENCE_HIGH=0.95
CONFIDENCE_MEDIUM=0.80
STRICT_FACTS=true

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK=0
